{
  "_fixture_comment": "SYNTHETIC production fixture for CFG-02 mutation testing. Every value is a clearly synthetic placeholder: UUIDs use RFC 4122 test ranges, matter roots under /synthetic-matters, OTLP endpoint on localhost. This file MUST pass production preflight; introducing a real defect must cause CI to fail.",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://synthetic-otel.example.invalid:4318",
    "CLAUDE_MATTER_ROOTS": "/synthetic-matters/Smith;/synthetic-matters/Jones",
    "CLAUDE_MATTER_MODE": "enforce"
  },
  "cleanupPeriodDays": 7,
  "feedbackSurveyRate": 0,
  "autoUpdatesChannel": "stable",
  "requiredMinimumVersion": "2.1.219",
  "requiredMaximumVersion": "2.1.300",
  "forceLoginMethod": "claudeai",
  "forceLoginOrgUUID": "00000000-0000-4000-8000-000000000001",
  "forceRemoteSettingsRefresh": true,
  "disableArtifact": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableAgentView": true,
  "disableSkillShellExecution": true,
  "disableSideloadFlags": true,
  "disableAutoMode": "disable",
  "browserExternalPageTools": "disabled",
  "disableBrowserExternalNavigation": true,
  "disableMobileSimulatorTools": true,
  "channelsEnabled": false,
  "strictKnownMarketplaces": [
    { "source": "github", "repo": "anthropics/claude-plugins-official" }
  ],
  "enableAllProjectMcpServers": false,
  "allowManagedMcpServersOnly": true,
  "allowManagedHooksOnly": true,
  "allowedMcpServers": [],
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(ftp:*)",
      "Bash(rsync:*)",
      "Bash(ssh:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(telnet:*)",
      "Bash(sudo:*)",
      "Bash(osascript:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(cmd.exe:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Edit(~/.claude/settings.json)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)"
    ]
  },
  "claudeMd": "Synthetic-firm policy for all Claude Code use. Scope. Confine each session to one matter. Start the session in that matter's folder, not in a parent folder, a drive root or your home directory.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${REPO_ROOT}/hooks/matter-guard.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${REPO_ROOT}/hooks/matter-guard.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${REPO_ROOT}/hooks/matter-guard.js\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowManagedReadPathsOnly": true,
      "denyRead": ["/", "~"],
      "allowRead": ["/synthetic-matters/Smith", "/synthetic-matters/Jones", "/usr/bin", "/opt/claude"],
      "allowWrite": ["/synthetic-matters/Smith", "/synthetic-matters/Jones", "/tmp/claude-session"]
    },
    "network": {
      "allowManagedDomainsOnly": true,
      "allowedDomains": ["api.anthropic.com", "synthetic-otel.example.invalid"]
    }
  }
}
